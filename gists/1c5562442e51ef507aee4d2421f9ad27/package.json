{
	"name": "monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"ready": "vp check && vp run -r build",
		"dev": "vp run website#dev",
		"build-all": "vp run ready && bash ./deploy.sh",
		"preview": "python3 -m http.server 3000 -d _pages_"
	},
	"devDependencies": {
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.22.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
