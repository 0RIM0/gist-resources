{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"allowUnreachableCode": false,
		"declaration": false,
		"experimentalDecorators": true,
		"lib": ["DOM", "DOM.Iterable", "DOM.AsyncIterable", "ESNext"],
		"moduleResolution": "bundler",
		"module": "esnext",
		"target": "esnext",
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"jsx": "react",
		"jsxFactory": "h"
	},
	"include": ["src"],
	"exclude": ["node_modules"]
}
